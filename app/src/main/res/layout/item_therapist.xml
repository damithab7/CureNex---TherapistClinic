<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@null"
    app:cardBackgroundColor="@color/md_theme_surfaceContainer"
    app:cardCornerRadius="10dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/item_card_padding">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
            android:layout_marginTop="5dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="@dimen/item_card_elevation"
            app:strokeWidth="@dimen/item_card_stroke_width">

            <ImageView
                android:id="@+id/item_therapist_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/welcomeimage" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:orientation="vertical">

            <TextView
                android:textStyle="bold"
                android:id="@+id/item_therapist_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="Women Shoes"
                android:textAlignment="textStart"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RatingBar
                    android:id="@+id/item_therapist_rating"
                    style="@style/Widget.AppCompat.RatingBar.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="1"
                    android:rating="4.5" />

                <TextView
                    android:id="@+id/item_therapist_star_rate_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="(4.5)"
                    android:textSize="@dimen/small_font_size" />
            </LinearLayout>

            <TextView
                android:id="@+id/item_therapist_rating_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="Women Shoes"
                android:textAlignment="textStart"
                android:textColor="@color/md_theme_secondary"
                android:textSize="13dp" />
        </LinearLayout>


    </LinearLayout>
</com.google.android.material.card.MaterialCardView>