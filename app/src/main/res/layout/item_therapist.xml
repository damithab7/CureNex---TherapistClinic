<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/md_theme_surface"
    android:background="@null"
    app:cardCornerRadius="10dp">
    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/item_card_padding">

        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="5dp"
           android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
            app:strokeWidth="@dimen/item_card_stroke_width"
            app:cardElevation="@dimen/item_card_elevation"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            app:cardCornerRadius="10dp">

            <ImageView
                android:id="@+id/item_therapist_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/welcomeimage" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
            android:textAlignment="textStart"
            android:fontFamily="@font/poppins"
            android:id="@+id/item_therapist_name_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_margin_top"
            android:textSize="@dimen/default_font_size"
            android:text="Women Shoes" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RatingBar
            android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
            android:layout_marginBottom="5dp"
            android:id="@+id/item_therapist_rating"
            style="@style/Widget.AppCompat.RatingBar.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rating="4.5" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(4.5)"
            android:textSize="@dimen/small_font_size"
            android:fontFamily="@font/poppins"
            android:id="@+id/item_therapist_star_rate_text"/>
    </LinearLayout>

        <TextView
            android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
            android:textAlignment="textStart"
            android:fontFamily="@font/poppins"
            android:textStyle="bold"
            android:id="@+id/item_therapist_rating_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16dp"
            android:text="Women Shoes" />


    </LinearLayout>
</com.google.android.material.card.MaterialCardView>