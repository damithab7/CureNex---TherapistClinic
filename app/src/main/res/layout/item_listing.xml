<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/md_theme_surface"
    android:background="@null"
    app:cardCornerRadius="10dp">
    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/item_card_padding">

        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="5dp"
            android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
            app:strokeWidth="@dimen/item_card_stroke_width"
            app:cardElevation="@dimen/item_card_elevation"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="10dp">

            <ImageView
                android:id="@+id/listing_item_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/welcomeimage" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
            android:textAlignment="textStart"
            android:fontFamily="@font/poppins"
            android:id="@+id/list_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:layout_marginTop="@dimen/small_margin_top"
            android:textSize="@dimen/default_font_size"
            android:textStyle="bold"
            android:text="Women Shoes" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
                android:textAlignment="textStart"
                android:fontFamily="@font/poppins"
                android:id="@+id/list_item_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="13dp"
                android:text="Women Shoes" />
            <androidx.cardview.widget.CardView
                android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
                android:layout_marginBottom="@dimen/item_card_margin_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/md_theme_secondaryContainer"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <TextView
                    android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
                    android:textAlignment="center"
                    android:fontFamily="@font/poppins"
                    android:id="@+id/list_item_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="0dp"
                    android:textColor="@color/stock_color"
                    android:textSize="@dimen/small_font_size"
                    android:text="In Stock" />

            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>