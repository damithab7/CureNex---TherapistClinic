<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@color/md_theme_surface"
    app:cardElevation="@dimen/item_card_elevation"
    app:strokeWidth="@dimen/item_card_stroke_width"
    app:cardCornerRadius="@dimen/item_card_corner_radius">
<LinearLayout
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/item_card_padding">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/item_service_card"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
        android:layout_marginTop="5dp"
        app:strokeWidth="@dimen/item_card_stroke_width"
        app:cardElevation="@dimen/item_card_elevation"
        app:cardCornerRadius="@dimen/item_card_corner_radius">

        <ImageView
            android:id="@+id/item_service_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/welcomeimage" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_marginHorizontal="@dimen/item_card_margin_horizontal"
        android:textAlignment="center"
        android:fontFamily="@font/poppins"
        android:id="@+id/item_service_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin_top"
        android:textSize="@dimen/small_font_size"
        android:text="Women Shoes"
        app:layout_constraintTop_toBottomOf="@id/item_service_card" />

</LinearLayout>
</com.google.android.material.card.MaterialCardView>