<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_gravity="center"
    android:layout_height="match_parent"
    android:paddingHorizontal="50dp"
    tools:context=".fragment.BookingConfirmedFragment">

    <ImageView
        android:id="@+id/dialog_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/check_circle_24px"
        android:contentDescription="Success Icon"
        android:layout_marginBottom="10dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:fontFamily="@font/poppins"
        android:textSize="18sp"
        android:textAlignment="center"
        android:text="We are please to inform you that your appointment has been confirmed "/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/booking_confirm_backtohomebtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        android:fontFamily="@font/poppins"/>

</LinearLayout>