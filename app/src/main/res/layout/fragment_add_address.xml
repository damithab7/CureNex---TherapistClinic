<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    tools:context=".fragment.AddAddressFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/address_bottom_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:fontFamily="@font/poppins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Shipping Details"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/shipping_layout_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_down_24"
                        android:layout_alignParentEnd="true"
                        android:rotation="180"/>

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/shipping_layout_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/shipping_details_name_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="First Name"
                        app:placeholderText="First Name"
                        app:placeholderTextAppearance="@style/placeholderFont">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/shipping_details_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:inputType="text"
                            android:padding="@dimen/edit_text_padding"
                            android:textSize="@dimen/edit_text_size" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/shipping_details_lastname_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Last Name"
                        app:placeholderText="Last Name"
                        app:placeholderTextAppearance="@style/placeholderFont">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/shipping_details_lastname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:inputType="text"
                            android:padding="@dimen/edit_text_padding"
                            android:textSize="@dimen/edit_text_size" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/email_placeholder_hint"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:id="@+id/shipping_details_email_layout"
                        app:placeholderText="example@email.com"
                        app:placeholderTextAppearance="@style/placeholderFont"
                        >
                        <EditText
                            android:id="@+id/shipping_details_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:fontFamily="@font/poppins"
                            android:textSize="@dimen/edit_text_size"

                            android:padding="@dimen/edit_text_padding" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/shipping_details_contact_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Contact Number"
                        app:placeholderText="Contact Number"
                        app:placeholderTextAppearance="@style/placeholderFont">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/shipping_details_contact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:inputType="phone"
                            android:padding="@dimen/edit_text_padding"
                            android:textSize="@dimen/edit_text_size" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/shipping_details_address1_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Address"
                        app:placeholderText="Address"
                        app:placeholderTextAppearance="@style/placeholderFont">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/shipping_details_address1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:inputType="text"
                            android:padding="@dimen/edit_text_padding"
                            android:textSize="@dimen/edit_text_size" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/shipping_details_address2_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Address 2"
                        app:placeholderText="Address 2"
                        app:placeholderTextAppearance="@style/placeholderFont">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/shipping_details_address2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:inputType="text"
                            android:padding="@dimen/edit_text_padding"
                            android:textSize="@dimen/edit_text_size" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/shipping_details_city_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="City"
                        app:placeholderText="City"
                        app:placeholderTextAppearance="@style/placeholderFont">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/shipping_details_city"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:inputType="text"
                            android:padding="@dimen/edit_text_padding"
                            android:textSize="@dimen/edit_text_size" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/shipping_details_postcode_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Postal Code"
                        app:placeholderText="Postal Code"
                        app:placeholderTextAppearance="@style/placeholderFont">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/shipping_details_postcode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins"
                            android:inputType="text"
                            android:padding="@dimen/edit_text_padding"
                            android:textSize="@dimen/edit_text_size" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/address_bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_address_btn"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/poppins"
            android:text="Save"
            android:textSize="@dimen/default_font_size" />
    </LinearLayout>

</RelativeLayout>